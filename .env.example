# SMTP credentials for api/contact.js — set these as Vercel project env vars,
# not in a committed .env. Any mailbox works (Google Workspace, Zoho, etc.).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@naazailabs.com
SMTP_PASS=

# Optional — defaults to SMTP_USER if unset. Where enquiries land.
CONTACT_TO_EMAIL=hello@naazailabs.com
